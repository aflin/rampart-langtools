+                if (!ggml_metal_device_get_obj((ggml_metal_device_t) dev->context)) {
+                    delete dev;
+                    g_devices = i; // as GGML_METAL_DEVICES=0
+                    break;
+                }
                 devs.emplace_back(dev);
 
                 reg_ctx->devices.push_back(dev);
